# HTCondor submit: one hadd job per sample. Reads samples.txt (one name per line).
# Each job runs job.sh <sample> on an el9 worker, reads CRAB outputs from the
# locally-mounted /pnfs, and returns <sample>.root into ../hadd/.
universe                = vanilla
executable              = job.sh
arguments               = $(sample)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = filelists/$(sample).txt
transfer_output_files   = $(sample).root
transfer_output_remaps  = "$(sample).root = ../hadd/$(sample).root"
environment             = "NCPU=4"

output                  = logs/$(sample).out
error                   = logs/$(sample).err
log                     = logs/$(sample).log

request_cpus            = 4
request_memory          = 4096
request_disk            = 20GB
requirements            = (OpSysMajorVer == 9)

queue sample from samples_resubmit.txt
